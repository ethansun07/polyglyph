# Copy to .env and fill in values. Never commit .env.
PORT=3001

# Postgres (local dev defaults — no password needed on Mac)
DB_HOST=localhost
DB_NAME=amharic_fidel
DB_USER=ethansun
DB_PASSWORD=
DB_PORT=5432

# In production (e.g. Render), set DATABASE_URL instead of the DB_* vars above.
# It takes priority over them when present.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Comma-separated list of origins allowed to call this API.
# In production, set this to your deployed frontend's URL.
CORS_ORIGIN=http://localhost:5173

# Google Cloud Text-to-Speech (used by scripts/generate-missing-audio.js and
# the live sentence-generator's audio synthesis). NOT the same product as
# Gemini below, even though both are "Google."
GOOGLE_API_KEY=

# Gemini text generation (Generative Language API) — powers the live
# "generate a sentence" feature in Read mode. Enable the Generative Language
# API on your Google Cloud project and create/reuse a key for this; it is a
# different API from Cloud Text-to-Speech above and needs its own key.
GEMINI_API_KEY=
